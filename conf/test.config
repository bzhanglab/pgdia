/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Repository-local runnable example profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Run from the repository root:
        nextflow run main.nf -profile test,docker --outdir results/test

    See examples/runnable_example/README.md for prerequisites and expected outputs.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Simulated PG-DIA example'
    config_profile_description = 'Repository-local RNA-seq, annotated-variant, reference, and DIA-MS fixtures'

    input                     = "${projectDir}/examples/runnable_example/samplesheet.csv"
    fasta                     = "${projectDir}/examples/runnable_example/data/simulated_genome.fasta"
    fasta_fai                 = "${projectDir}/examples/runnable_example/data/simulated_genome.fasta.fai"
    dict                      = "${projectDir}/examples/runnable_example/data/simulated_genome.dict"
    gtf                       = "${projectDir}/examples/runnable_example/data/simulated_annotation.gtf"
    protein_reference_db      = "${projectDir}/examples/runnable_example/data/simulated_proteins.fasta"
    precomputed_annotated_vcf = "${projectDir}/examples/runnable_example/data/simulated_vep_annotated.vcf"

    genome                 = null
    igenomes_ignore        = true
    tools                  = null
    skip_baserecalibration = true
    skip_variantannotation = true
    skip_intervallisttools = true
    skip_multiqc           = true
    gatk_interval_scatter_count = 1

    max_cpus   = 4
    max_memory = '15.GB'
    max_time   = '1.h'
    diann_cpus = 2

    // PGDIA_DIANN_IMAGE may be an image tag or a tar file; PGDIA_DIANN_TAG is
    // the image tag used to execute DIA-NN after any tar file has been loaded.
    diann_image   = System.getenv('PGDIA_DIANN_IMAGE') ?: 'diann-2.0.2:latest'
    diann_tar_tag = System.getenv('PGDIA_DIANN_TAG') ?: (System.getenv('PGDIA_DIANN_IMAGE') ?: 'diann-2.0.2:latest')
    diann_bin     = System.getenv('PGDIA_DIANN_BIN') ?: '/diann-2.0.2/diann-linux'
}
