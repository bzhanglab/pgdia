// Copy this directory for each new species/cohort, then fill in the marked fields.
// Use absolute reference paths. FASTA, GTF and protein DB must match the species
// and assembly. Supply uncompressed genome FASTA and GTF for this branch.
params {
    genome = 'new_species' // Alias for the genomes entry below; keep both in sync.
    organism = 'REPLACE_SCIENTIFIC_NAME'
    taxonomy_id = 'REPLACE_NCBI_TAXONOMY_ID'
    protein_reference_db = '/REPLACE_REFERENCE_ROOT/proteins.fasta'

    cohort_db_id = 'REPLACE_COHORT_ID'
    cohort_expected_runs = 6 // Integer: unique run IDs, not number of samples.

    // Keep variants found in at least one run. Increase for stricter filtering.
    variant_peptide_min_runs = 1
    variant_peptide_require_pass = true

    // Build an annotation cache from these exact reference files.
    tools = 'snpeff'
    build_snpeff_refseq_cache = true
    download_cache = false
    skip_variantannotation = false
    generate_gvcf = false

    // No matching known-sites VCF assumed for a new species.
    skip_baserecalibration = true
    read_length = null // Infer from the first FASTQ; use a uniform read length.

    genomes {
        'new_species' {
            fasta = '/REPLACE_REFERENCE_ROOT/genome.fa'
            // Create this index before launching: samtools faidx genome.fa
            fasta_fai = '/REPLACE_REFERENCE_ROOT/genome.fa.fai'
            gtf = '/REPLACE_REFERENCE_ROOT/annotation.gtf'
            snpeff_db = 'REPLACE_ASSEMBLY_ID_local'
            snpeff_genome_name = 'REPLACE_SCIENTIFIC_NAME REPLACE_ASSEMBLY_ID'

            // Optional compatible STAR index. The genome attribute is "star".
            // star = '/absolute/path/to/star_index'
            // Optional sequence dictionary; otherwise generated by the pipeline.
            // dict = '/absolute/path/to/genome.dict'
        }
    }

    // Optional BQSR: set skip_baserecalibration=false and set BOTH top-level
    // parameters below to a bgzip VCF and its tabix index for this assembly.
    // dbsnp = '/absolute/path/to/known_sites.vcf.gz'
    // dbsnp_tbi = '/absolute/path/to/known_sites.vcf.gz.tbi'

    email = null
    email_on_fail = null
}

notification.enabled = false

// Resources inherit the branch defaults. Adjust to the genome and run host.
// In particular, local snpEff cache building currently requests 180 GB.
// Example overrides (uncomment and tune):
// process {
//     withName: BUILD_SNPEFF_REFSEQ_CACHE { memory = 180.GB; time = 24.h }
//     withName: STAR_GENOMEGENERATE { cpus = 12; memory = 72.GB; time = 24.h }
//     withName: STAR_ALIGN { cpus = 12; memory = 72.GB }
//     withName: '.*:SPLITNCIGAR:GATK4_SPLITNCIGARREADS' { time = 48.h }
// }
